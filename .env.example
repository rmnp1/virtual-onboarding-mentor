DATABASE_URL=sqlite:///./data/db.sqlite
# SECRET_KEY is REQUIRED (min 32 chars). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
JWT_EXPIRE_MINUTES=1440
CHROMA_PERSIST_DIR=./data/chroma
# Comma-separated allowed CORS origins. Leave empty to disable CORS (same-origin SPA).
# CORS_ORIGINS=https://app.example.com,http://localhost:3000
# Set to true to require an invite code for registration
# INVITE_REQUIRED=false
# Comma-separated valid invite codes (case-insensitive)
# INVITE_CODES=alpha,beta,gamma
# Set to false to hide /docs and /openapi.json in production
EXPOSE_DOCS=true
