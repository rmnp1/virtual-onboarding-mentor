DATABASE_URL=sqlite:///./data/db.sqlite
# SECRET_KEY is REQUIRED (min 32 chars). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
JWT_EXPIRE_MINUTES=1440
CHROMA_PERSIST_DIR=./data/chroma
# Comma-separated allowed CORS origins. Leave empty to disable CORS (same-origin SPA).
# CORS_ORIGINS=https://app.example.com,http://localhost:3000
# Set to true to require an invite code for registration
# INVITE_REQUIRED=false
# Comma-separated valid invite codes (case-insensitive)
# INVITE_CODES=alpha,beta,gamma
# Set to false to hide /docs and /openapi.json in production
EXPOSE_DOCS=true
# Log verbosity: INFO (default) or DEBUG
# LOG_LEVEL=INFO

# --- Chat + embedding provider (ollama | gemini) ---
# Local default is "ollama". For cloud (Render), set "gemini" and provide an API key.
LLM_PROVIDER=ollama
LLM_MODEL=llama3
# LLM_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=
# pgvector dimension; must match EMBEDDING_MODEL (gemini-embedding-001 -> 768)
EMBEDDING_DIMENSION=768
# Retry transient Gemini errors (429/500/502/503/504) with exponential backoff
# GEMINI_MAX_RETRIES=3
# GEMINI_RETRY_BASE_DELAY=1.0

# --- PostgreSQL (production) ---
# For cloud, point at PostgreSQL + pgvector (e.g. Supabase). SQLite remains the local default.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/dbname
